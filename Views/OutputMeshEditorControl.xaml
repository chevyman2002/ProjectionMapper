<UserControl x:Class="ProjectionMapper.Views.OutputMeshEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="100" MinWidth="100">
    <Grid Background="Transparent">
        <Canvas x:Name="PART_Canvas" Background="Transparent" IsHitTestVisible="True" Width="1920" Height="1080">
            <!-- Live preview of the cropped frame for the selected mesh -->
            <Image x:Name="PART_CroppedPreview" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False" />

            <Polygon x:Name="PART_OutputPolygon" Stroke="LimeGreen" StrokeThickness="2" Fill="#4033DB33" Visibility="Collapsed" IsHitTestVisible="False" />
            <!-- Corner resize thumbs -->
            <Thumb x:Name="PART_Handle_TL" Width="12" Height="12" Visibility="Collapsed" Background="White" BorderBrush="Black" BorderThickness="1" />
            <Thumb x:Name="PART_Handle_TR" Width="12" Height="12" Visibility="Collapsed" Background="White" BorderBrush="Black" BorderThickness="1" />
            <Thumb x:Name="PART_Handle_BL" Width="12" Height="12" Visibility="Collapsed" Background="White" BorderBrush="Black" BorderThickness="1" />
            <Thumb x:Name="PART_Handle_BR" Width="12" Height="12" Visibility="Collapsed" Background="White" BorderBrush="Black" BorderThickness="1" />
        </Canvas>
    </Grid>
</UserControl>