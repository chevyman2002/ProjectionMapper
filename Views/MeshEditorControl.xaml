<UserControl x:Class="ProjectionMapper.Views.MeshEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             MinHeight="200" MinWidth="200">
    <Grid Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
        <!-- A simple canvas where mesh editing will be implemented.
             Future: custom Adorner layer, handles, snapping grid, zoom/pan transforms.
        -->
        <Canvas Name="PART_Canvas" Background="Transparent" ClipToBounds="True"/>
    </Grid>
</UserControl>