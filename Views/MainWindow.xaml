<Window x:Class="ProjectionMapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ProjectionMapper.Views"
        xmlns:vm="clr-namespace:ProjectionMapper.ViewModels"
        xmlns:models="clr-namespace:ProjectionMapper.Models"
        xmlns:conv="clr-namespace:ProjectionMapper.Converters"
        Title="Projection Mapper" Height="720" Width="1200" WindowState="Maximized"
        Loaded="Window_Loaded">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <!-- Inverse boolean to visibility converter for showing/hiding based on negated condition -->
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding LoadProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsProjectCommand}" />
        <KeyBinding Key="F5" Command="{Binding PreviewCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyMeshCommand}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteMeshCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteMeshCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N" />
                <Separator />
                <MenuItem Header="_Open..." Command="{Binding LoadProjectCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Save" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As..." Command="{Binding SaveAsProjectCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
            </MenuItem>
            <MenuItem Header="_Playlist">
                <MenuItem Header="Create Group" Command="{Binding CreateGroupCommand}" />
                <MenuItem Header="Delete Group" Command="{Binding DeleteGroupCommand}" />
                <Separator />
                <MenuItem Header="Move Group Up" Command="{Binding MoveGroupUpCommand}" />
                <MenuItem Header="Move Group Down" Command="{Binding MoveGroupDownCommand}" />
                <Separator />
                <MenuItem Header="Toggle Playlist Mode" Command="{Binding TogglePlaylistModeCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Preview" Command="{Binding PreviewCommand}" InputGestureText="F5" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="AboutMenuItem_Click" />
            </MenuItem>
        </Menu>

        <!-- Tool bar -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="False">
            <ToolBar>
                <Button Content="Import" Command="{Binding ImportCommand}" />

                <!-- Play / Pause (icon changes based on IsPlaying) -->
                <Button Command="{Binding PlayPauseCommand}" ToolTip="Play / Pause">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="▶" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Content" Value="⏸" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Command="{Binding RestartCommand}" ToolTip="Restart">
                    <Button.Content>
                        <TextBlock Text="⟲" />
                    </Button.Content>
                </Button>

                <Separator />
                <TextBlock Text="Input Zoom" VerticalAlignment="Center" Margin="8,0,4,0" />
                <Slider Width="120" Minimum="0.5" Maximum="4" Value="{Binding InputZoom, Mode=TwoWay}" />
                <TextBlock Text="Output Zoom" VerticalAlignment="Center" Margin="8,0,4,0" />
                <Slider Width="120" Minimum="0.5" Maximum="4" Value="{Binding OutputZoom, Mode=TwoWay}" />
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding StatusText}" />
            <Separator Margin="8,0" />
            <TextBlock Text="{Binding MeshSelectionText}" Foreground="DodgerBlue" />
        </StatusBar>

        <!-- Main content: left panel (unified project tree + properties), center (input/output split horizontal) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Left: Unified Project Tree + Properties -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,0" Padding="6" Margin="0,0,10,0">
                <StackPanel>
                    <!-- Playlist Mode Toggle -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold" />
                        <ToggleButton x:Name="PART_PlaylistModeToggle" 
                                      IsChecked="{Binding IsPlaylistMode, Mode=TwoWay}" 
                                      Content="{Binding PlaylistModeText}"
                                      ToolTip="Toggle between Legacy mode (all videos play independently) and Playlist mode (groups play sequentially)"
                                      Padding="8,2"
                                      MinWidth="100" />
                        <Button Content="+" Command="{Binding CreateGroupCommand}" ToolTip="Create Group" Width="24" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock FontWeight="Bold" Text="Project" Margin="0,0,0,4"/>

                    <!-- Unified TreeView with Groups, Videos, and Meshes -->
                    <TreeView x:Name="PART_ProjectTree"
                              ItemsSource="{Binding ProjectTree}" 
                              SelectedItemChanged="TreeView_SelectedItemChanged" 
                              PreviewMouseRightButtonDown="TreeView_PreviewMouseRightButtonDown"
                              AllowDrop="True"
                              Height="380"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <TreeView.Resources>
                            <!-- Template for Playlist Group -->
                            <HierarchicalDataTemplate DataType="{x:Type vm:PlaylistGroupTreeViewModel}" ItemsSource="{Binding Videos}">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename Group" Click="RenameGroupMenuItem_Click" />
                                            <MenuItem Header="Delete Group" Click="DeleteGroupMenuItem_Click" />
                                            <Separator />
                                            <MenuItem Header="Move Up" Click="MoveGroupUpMenuItem_Click" />
                                            <MenuItem Header="Move Down" Click="MoveGroupDownMenuItem_Click" />
                                            <Separator />
                                            <MenuItem Header="Playback Mode">
                                                <MenuItem Header="Sequential (One at a Time)" 
                                                          Click="SequentialModeMenuItem_Click"
                                                          IsCheckable="True"
                                                          IsChecked="{Binding IsSequentialMode, Mode=OneWay}" />
                                                <MenuItem Header="Simultaneous (All at Once)" 
                                                          Click="SimultaneousModeMenuItem_Click"
                                                          IsCheckable="True"
                                                          IsChecked="{Binding IsSimultaneousMode, Mode=OneWay}" />
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Play This Group Now" Click="PlayGroupNowMenuItem_Click" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    
                                    <!-- Active indicator (green dot) -->
                                    <TextBlock Text="●" 
                                               Foreground="LimeGreen" 
                                               Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                               Margin="0,0,4,0" 
                                               FontSize="14" 
                                               ToolTip="Currently playing group" />
                                    
                                    <!-- Group icon -->
                                    <TextBlock Text="📊" Margin="0,0,4,0" FontSize="14" />
                                    
                                    <!-- Group name and video count -->
                                    <TextBlock Text="{Binding DisplayText}" FontWeight="Bold" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            
                            <!-- Template for Imported Video (can be child of group or root) -->
                            <HierarchicalDataTemplate DataType="{x:Type vm:ImportedVideoTreeViewModel}" ItemsSource="{Binding ImportedVideo.MeshLayers}">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu Opened="VideoContextMenu_Opened">
                                            <MenuItem Header="Create Mesh Layer" Click="CreateMeshMenuItem_Click" />
                                            <MenuItem Header="Create Sliced Mesh Layers">
                                                <MenuItem Header="2 Horizontal Slices" Click="CreateSlicedMeshMenuItem_Click" Tag="2" />
                                                <MenuItem Header="4 Horizontal Slices" Click="CreateSlicedMeshMenuItem_Click" Tag="4" />
                                                <MenuItem Header="6 Horizontal Slices" Click="CreateSlicedMeshMenuItem_Click" Tag="6" />
                                                <MenuItem Header="8 Horizontal Slices" Click="CreateSlicedMeshMenuItem_Click" Tag="8" />
                                                <MenuItem Header="10 Horizontal Slices" Click="CreateSlicedMeshMenuItem_Click" Tag="10" />
                                            </MenuItem>
                                            <MenuItem Header="Delete Source" Click="DeleteSourceMenuItem_Click" />
                                            <Separator />
                                            <MenuItem Header="Remove from Group" 
                                                      Click="RemoveVideoFromGroupMenuItem_Click" 
                                                      x:Name="PART_RemoveFromGroupMenuItem" />
                                            <MenuItem Header="Add to Group" x:Name="PART_AddToGroupMenuItem">
                                                <!-- Dynamic submenu populated in code-behind -->
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Copy Mesh" Click="CopyMeshMenuItem_Click" InputGestureText="Ctrl+C" />
                                            <MenuItem Header="Paste Mesh" Click="PasteMeshMenuItem_Click" InputGestureText="Ctrl+V" />
                                            <Separator />
                                            <MenuItem Header="Hide Source Output/Meshes" Tag="HideShowToggle" Click="HideSourceOutputMenuItem_Click" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    
                                    <!-- Video icon -->
                                    <TextBlock Text="🎬" Margin="0,0,4,0" FontSize="14" />
                                    
                                    <!-- Video name with audio indicator -->
                                    <TextBlock Text="{Binding DisplayText}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            
                            <!-- Template for Mesh Layer (child of video) -->
                            <DataTemplate DataType="{x:Type vm:LayerViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu Opened="MeshContextMenu_Opened">
                                            <MenuItem Header="Rename Mesh" Click="RenameMeshMenuItem_Click" />
                                            <MenuItem x:Name="PART_DeleteMeshMenuItem" Header="Delete Mesh Layer" Click="DeleteMeshMenuItem_Click" />
                                            <Separator />
                                            <MenuItem x:Name="PART_CopyMeshMenuItem" Header="Copy Mesh" Click="CopyMeshMenuItem_Click" InputGestureText="Ctrl+C" />
                                            <MenuItem Header="Paste Mesh" Click="PasteMeshMenuItem_Click" InputGestureText="Ctrl+V" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    
                                    <!-- Multi-selection indicator (checkmark when part of multi-selection) -->
                                    <TextBlock Text="✓" 
                                               Foreground="DodgerBlue" 
                                               FontWeight="Bold"
                                               Visibility="{Binding IsMultiSelected, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                               Margin="0,0,2,0" 
                                               FontSize="12" 
                                               ToolTip="Part of multi-selection" />
                                    
                                    <!-- Mesh icon -->
                                    <TextBlock Text="📐" Margin="0,0,4,0" FontSize="13" />
                                    
                                    <!-- Mesh name -->
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <Separator Margin="0,8,0,8" />

                    <TextBlock FontWeight="Bold" Text="Properties" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Show Mesh Overlay (global):" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <CheckBox x:Name="PART_GlobalShowMeshOverlayCheckbox" IsChecked="False" VerticalAlignment="Center" 
                                  Checked="OnGlobalShowMeshOverlayChanged" Unchecked="OnGlobalShowMeshOverlayChanged" />
                    </StackPanel>
                    
                    <!-- Simple inspector for selected mesh layer -->
                    <StackPanel DataContext="{Binding SelectedMeshLayer}" Margin="0,8,0,0">
                        <TextBlock Text="Selected:" FontWeight="Bold" />
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="Source:" FontWeight="Bold" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" />
                        <TextBlock Text="Opacity:" FontWeight="Bold" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Opacity}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Visible:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <CheckBox IsChecked="{Binding Visible, Mode=TwoWay}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- If a mesh layer is selected, allow rotation -->
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding Name, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="Rotation (deg):" FontWeight="Bold" />
                            <Slider Minimum="-180" Maximum="180" Value="{Binding RotationDegrees, Mode=TwoWay}" />

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Output Display:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="PART_MeshMonitorCombo" Width="150" SelectedIndex="-1" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Show Mesh Overlay on Output:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <CheckBox IsChecked="{Binding ShowOverlay, Mode=TwoWay}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- If an imported video is selected show audio controls (not monitor - only mesh layers target monitors) -->
                    <StackPanel Margin="0,8,0,0" DataContext="{Binding SelectedImportedVideo}"
                                Visibility="{Binding ., Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock FontWeight="Bold" Text="Selected Source Properties" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Play Audio:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <CheckBox x:Name="PART_PlayAudioCheckbox" IsChecked="{Binding PlayAudio, Mode=TwoWay}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Center: split input (top) and output (bottom) with a horizontal divider -->
            <Border Grid.Column="1" Background="Black" Margin="4,4,4,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Input panel (top) -->
                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <TextBlock Text="Input Preview" Foreground="White" FontWeight="Bold" DockPanel.Dock="Top" Margin="6" />
                        <ScrollViewer x:Name="PART_InputScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both">
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding InputZoom}" ScaleY="{Binding InputZoom}" />
                                </Grid.RenderTransform>
                                <views:RenderHostControl x:Name="PART_InputHost" />
                                <views:MeshEditorControl x:Name="PART_MeshEditor" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                         SelectedLayer="{Binding SelectedMeshLayer, Mode=TwoWay}"
                                                         AllMeshLayers="{Binding SelectedImportedVideo.MeshLayers, Mode=OneWay}"
                                                         SelectedSourceId="{Binding SelectedImportedVideo.HostLayer.Id, Mode=OneWay}"
                                                         VideoService="{DynamicResource VideoService}"
                                                         RendererManager="{DynamicResource RendererManager}"
                                                         InputHost="{Binding ElementName=PART_InputHost}"
                                                         ParentScrollViewer="{Binding ElementName=PART_InputScroll}"
                                                         UndoRedoService="{Binding UndoRedoService}"
                                                         Zoom="{Binding InputZoom, Mode=TwoWay}" />
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Divider -->
                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Gray" ShowsPreview="True" />

                    <!-- Output panel (bottom) -->
                    <DockPanel Grid.Row="2" LastChildFill="True">
                        <TextBlock Text="Output Preview" Foreground="White" FontWeight="Bold" DockPanel.Dock="Top" Margin="6" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both">
                            <Grid RenderTransformOrigin="0.5,0.5" MinWidth="800" MinHeight="450">
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding OutputZoom}" ScaleY="{Binding OutputZoom}" />
                                </Grid.RenderTransform>
                                <views:RenderHostControl x:Name="PART_OutputHost" />

                                <!-- Output mesh editor binds to SelectedMeshLayer so output rect is adjustable -->
                                <views:OutputMeshEditorControl SelectedLayer="{Binding SelectedMeshLayer, Mode=TwoWay}" 
                                                               AllMeshLayers="{Binding SelectedImportedVideo.MeshLayers, Mode=OneWay}"
                                                               VideoService="{DynamicResource VideoService}" 
                                                               HostRenderHost="{Binding ElementName=PART_OutputHost}" 
                                                               RendererManager="{DynamicResource RendererManager}"
                                                               UndoRedoService="{Binding UndoRedoService}" />
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>