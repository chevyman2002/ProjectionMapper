<Window x:Class="ProjectionMapper.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Projection Mapper" 
        Height="400" Width="500" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Icon -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image x:Name="PART_AppIcon" Width="64" Height="64" Margin="0,0,20,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Projection Mapper" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock x:Name="PART_VersionText" 
                               Text="Version 1.0.0" 
                               FontSize="14" 
                               Foreground="#BDC3C7"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <TextBlock Text="About" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Margin="0,0,0,10"/>
                
                <TextBlock TextWrapping="Wrap" 
                           LineHeight="22"
                           Margin="0,0,0,15">
                    <Run Text="Open source projection mapping software, inspired by the MapMap project."/>
                </TextBlock>

                <TextBlock Text="Author" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Margin="0,10,0,10"/>
                
                <TextBlock TextWrapping="Wrap" 
                           LineHeight="22"
                           Margin="0,0,0,15">
                    <Run Text="Developed by Aaron Merritt"/>
                    <LineBreak/>
                    <Run Text="Built with C# .NET 9 and WPF"/>
                </TextBlock>

                <TextBlock Text="Technology" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Margin="0,10,0,10"/>
                
                <TextBlock TextWrapping="Wrap" 
                           LineHeight="22"
                           Margin="0,0,0,15">
                    <Run Text="- Framework: .NET 9"/>
                    <LineBreak/>
                    <Run Text="- UI: Windows Presentation Foundation (WPF)"/>
                    <LineBreak/>
                    <Run Text="- Video Processing: FFmpeg"/>
                    <LineBreak/>
                    <Run Text="- Audio: NAudio"/>
                    <LineBreak/>
                    <Run Text="- Development: 100% AI-assisted (GitHub Copilot)"/>
                </TextBlock>

                <TextBlock Text="License" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Margin="0,10,0,10"/>
                
                <TextBlock TextWrapping="Wrap" 
                           LineHeight="22"
                           Margin="0,0,0,15">
                    <Run Text="GNU Affero General Public License v3.0 (AGPL-3.0)"/>
                    <LineBreak/>
                    <Run Text="This is free and open source software."/>
                </TextBlock>

                <TextBlock Text="Source Code" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Margin="0,10,0,10"/>
                
                <TextBlock TextWrapping="Wrap" 
                           LineHeight="22">
                    <Hyperlink NavigateUri="https://github.com/chevyman2002/ProjectionMapper" 
                               RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="https://github.com/chevyman2002/ProjectionMapper"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer with Close Button -->
        <Border Grid.Row="2" 
                Background="#ECF0F1" 
                BorderBrush="#BDC3C7" 
                BorderThickness="0,1,0,0" 
                Padding="20,15">
            <Button Content="Close" 
                    Width="100" 
                    Height="30"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    Click="CloseButton_Click"/>
        </Border>
    </Grid>
</Window>
